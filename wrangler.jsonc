{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Static site: wrangler deploy uploads the Vite build (no Worker code).
  "name": "sql-snob",
  "compatibility_date": "2026-11-04",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [{ "pattern": "sqlsnob.com", "custom_domain": true }]
}

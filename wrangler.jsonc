{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The Vite build as static assets, plus worker/index.ts for /api/* (shared queries in KV).
  "name": "sql-snob",
  "compatibility_date": "2026-11-04",
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [
    // Shared queries (encrypted blobs). Created with `npx wrangler kv namespace create SHARES`.
    { "binding": "SHARES", "id": "62c0006e34b749eab7a6bdeafc1bcc10" }
  ],
  "routes": [{ "pattern": "sqlsnob.com", "custom_domain": true }]
}
